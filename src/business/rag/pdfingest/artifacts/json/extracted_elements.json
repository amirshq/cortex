 \"text\": \"b KTH Royal Institute of Technology, Stockholm, Sweden\",\n        \"type\": \"ListItem\"\n    },\n    {\n        \"element_id\": \"b36f6290ec3b72a64d3319099f48024f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        754.3\n                    ],\n                    [\n                        104.4,\n                        778.7\n                    ],\n                    [\n                        327.1,\n                        778.7\n                    ],\n                    [\n                        327.1,\n                        754.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.44105,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1\n        },\n        \"text\": \"A R T I C L E I N F O\",\n        \"type\": \"Title\"\n    },\n    {\n        \"element_id\": \"96ff1a750677b682d53c88fa29f5cb57\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        560.8,\n                        754.6\n                    ],\n                    [\n                        560.8,\n                        778.7\n                    ],\n                    [\n                        721.7,\n                        778.7\n                    ],\n                    [\n                        721.7,\n                        754.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.46565,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1\n        },\n        \"text\": \"A B S T R A C T\",\n        \"type\": \"Title\"\n    },\n    {\n        \"element_id\": \"71118f5e9417107a190b1f2cde7d77ef\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        811.3\n                    ],\n                    [\n                        104.4,\n                        1043.7\n                    ],\n                    [\n                        355.2,\n                        1043.7\n                    ],\n                    [\n                        355.2,\n                        811.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.76111,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"Keywords: Distributed district heating Clustering Energy performance certificates Economic viability Urban energy planning Heat source allocation Sustainability Marginal cost of heat Policy implications\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"8d8fa658467b30539e00e45e0ad1947e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        561.1,\n                        812.7\n                    ],\n                    [\n                        561.1,\n                        1364.5\n                    ],\n                    [\n                        1555.0,\n                        1364.5\n                    ],\n                    [\n                        1555.0,\n                        812.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93802,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"This study introduces a high-resolution, data-driven approach for optimizing district heating networks using source-load mapping, focusing on Stockholm as a case study. The methodology integrates detailed building energy performance data (2014\\u20132022) with geographic data from the Swedish Survey Agency, employing advanced clustering techniques such as K-means Clustering, Agglomerative Clustering, DBSCAN, Spectral Clustering, and Gaussian Mixture Model (GMM) Clustering to identify optimal locations for distributed heat sources, including data centers, supermarkets, and water bodies. Quantitative results show that these environ- mentally friendly sources could supply 54 % of Stockholm\\u2019s total annual heat demand of 7.7 TWh/year, equating to 4.2 TWh from residual heat sources. Data centers contribute 0.48 TWh, water bodies provide 3.4 TWh, and supermarkets contribute 0.3 TWh annually. Economic analysis further reveals that 98 % of residual heat sources are economically viable, with marginal costs of heat (MCOH) for data centers, supermarkets, and water bodies estimated at 12.7 EUR/MWh, 16.0 EUR/MWh, and 20.0 EUR/MWh, respectively\\u2014well below the Open District Heating (ODH) market price of 22.0 EUR/MWh. The policy implications of these findings are profound. Poli- cymakers can leverage this methodology to identify economically viable heat sources, enabling the creation of regulations that incentivize the integration of distributed heat sources into existing district heating networks. This can lead to reduced energy costs, enhanced sustainability, and more resilient energy systems. Practically, urban planners and energy utilities can use clustering insights to optimize the placement of new infrastructure, such as data centers, ensuring they are strategically located in high-demand zones. Furthermore, the study\\u2019s methodology can be replicated in other urban contexts, offering cities worldwide a scalable tool for improving the efficiency and sustainability of their heating networks. These findings support the transition to low-carbon energy solutions and provide actionable recommendations for the long-term development of urban energy systems.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"8f815c48b15947ad93a7357690cd2b23\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        105.0,\n                        1446.0\n                    ],\n                    [\n                        105.0,\n                        1475.0\n                    ],\n                    [\n                        237.0,\n                        1475.0\n                    ],\n                    [\n                        237.0,\n                        1446.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"Introduction\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"2b80c5d9be86ec093e9f1969f11d33d3\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1453.6\n                    ],\n                    [\n                        104.4,\n                        1475.7\n                    ],\n                    [\n                        237.8,\n                        1475.7\n                    ],\n                    [\n                        237.8,\n                        1453.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"Introduction\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"0909dfcfb93b233743ab4206ce71c6ac\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.4,\n                        1507.8\n                    ],\n                    [\n                        103.4,\n                        1789.3\n                    ],\n                    [\n                        808.4,\n                        1789.3\n                    ],\n                    [\n                        808.4,\n                        1507.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95616,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"District heating networks offer significant opportunities to rapidly transform energy supply in buildings and cities. Changing the fuel sources for heating plants makes it possible to increase the proportion of renewable energy or decarbonize the heating supply with minimal intervention from building owners. Sweden is a global leader in this area, with approximately 500 cities or communities utilizing district heating networks that supply heat to 55 % of the building area [1]. Most heat is generated by combustion fueled by residuals from the forestry industry and municipal solid waste, with peaks often covered by fossil\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"081dacec6384bedf3a342ecabd161b1d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1773.1\n                    ],\n                    [\n                        104.4,\n                        1795.2\n                    ],\n                    [\n                        194.6,\n                        1795.2\n                    ],\n                    [\n                        194.6,\n                        1773.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"fuels [2].\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"1b72999de1bc40488b56443e323f484a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1449.6\n                    ],\n                    [\n                        851.6,\n                        1737.1\n                    ],\n                    [\n                        1555.6,\n                        1737.1\n                    ],\n                    [\n                        1555.6,\n                        1449.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95616,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"Traditionally, heating networks are centered around large, central- ized plants. However, Stockholm\\u2019s Open District Heating market illus- trates how distributed heat sources\\u2014such as supermarkets, ice rinks, and data centers\\u2014can recover and contribute heat that would otherwise be wasted [3]. This system allows facilities with substantial cooling demands to sell their excess heat to the network, creating a unique prosumer market for heat similar to the prosumer model in the elec- tricity sector. While heavy industry has long contributed to heating networks through specialized agreements, this marketplace opens participation to smaller, distributed stakeholders.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"09bface9fe72dd9178aee33dbc1b9cf4\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1741.4\n                    ],\n                    [\n                        851.6,\n                        1795.2\n                    ],\n                    [\n                        1555.6,\n                        1795.2\n                    ],\n                    [\n                        1555.6,\n                        1741.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.91623,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"96ff1a750677b682d53c88fa29f5cb57\"\n        },\n        \"text\": \"High spatial and temporal resolution data are essential to effectively integrate distributed heat sources into district heating networks. The\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"9d1609293970b645bf3eedb3836abce3\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        118.4,\n                        1871.2\n                    ],\n                    [\n                        118.4,\n                        1891.1\n                    ],\n                    [\n                        337.3,\n                        1891.1\n                    ],\n             