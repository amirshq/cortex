      ],\n            \"page_number\": 1,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"2590-1745/\\u00a9 2024 The Authors. Published by Elsevier Ltd. This is an open access article under the CC BY-NC-ND license ( http://creativecommons.org/licenses/by-\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ad2bb4bbb455e4546d432ac56332959e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.2,\n                        2047.0\n                    ],\n                    [\n                        104.2,\n                        2066.9\n                    ],\n                    [\n                        220.2,\n                        2066.9\n                    ],\n                    [\n                        220.2,\n                        2047.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 1,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"nc-nd/4.0/ ).\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"09cabe7fdb673c03e790eb993b9c3a13\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        104.7\n                    ],\n                    [\n                        104.4,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"A. Shahcheraghian et al.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"7ebfbef8d9479ac82921e2a0b785fc45\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1109.2,\n                        104.7\n                    ],\n                    [\n                        1109.2,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Energy Conversion and Management: X 25 (2025) 100860\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"7a137cbe8fc62ba25a7b42ca708079c1\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        152.0\n                    ],\n                    [\n                        104.4,\n                        324.0\n                    ],\n                    [\n                        808.4,\n                        324.0\n                    ],\n                    [\n                        808.4,\n                        152.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95134,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"growing availability of high-resolution geographic information systems (GIS) data has led to numerous district heating planning studies. On the demand side, large cities such as London [4], Berlin [5], and Helsinki [6] have mapped out their building energy demands. Studies in Switzerland [7] and China [8] have mapped the potential of ground-source heat pumps.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"681a52c1a92d80431dbfb9fa9c1df2a2\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.7,\n                        327.8\n                    ],\n                    [\n                        102.7,\n                        701.7\n                    ],\n                    [\n                        808.4,\n                        701.7\n                    ],\n                    [\n                        808.4,\n                        327.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95464,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"So far, high-resolution mapping has primarily focused on buildings and heat demand. However, source-load mapping, which identifies po- tential heat sources, is often conducted at a minimum resolution of 1 km, which is insufficient for urban environments. Renewable heat sources, which are seasonally variable and typically produce low temperatures, require enhancements via heat pumps. The electrification of heat pro- duction demands hourly time resolution to account for fluctuations in supply profiles and temperature levels, both of which impact system efficiency. Additionally, electricity prices, which have become more volatile since the withdrawal of Russian natural gas from the European market, vary by the hour. High temporal resolution is also crucial for accurately modeling storage systems, especially in such a volatile pric- ing environment.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"2cfd1366acc748a939490f128139e75a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        704.1\n                    ],\n                    [\n                        104.4,\n                        905.1\n                    ],\n                    [\n                        808.3,\n                        905.1\n                    ],\n                    [\n                        808.3,\n                        704.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95108,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"This study uses high-resolution source-load mapping to develop a novel data-driven approach to district heating network planning during the pre-feasibility stages. Unlike existing methods, this approach in- tegrates detailed spatial data for both distributed heat demand and supply sources, identifying optimal locations for new heat sources and potential areas for heat recovery. This leads to more efficient and cost- effective district heating infrastructure designs.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"2e10c40ee6eda554d420662b1b474e40\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        908.5\n                    ],\n                    [\n                        104.4,\n                        1253.8\n                    ],\n                    [\n                        808.4,\n                        1253.8\n                    ],\n                    [\n                        808.4,\n                        908.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9543,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Stockholm is used as a case study due to the availability of data, particularly the distributed heat-source dataset from Su et al. [9], on which this research is based. The study\\u2019s objectives include analyzing how existing distributed resources can be optimally allocated to meet the city\\u2019s heat demand, identifying the best locations for new data centers that can serve as significant heat sources, assessing the economic feasibility of utilizing heat from these distributed sources, and devel- oping a comprehensive spatial database that includes detailed building energy performance metrics across multiple years (2014\\u20132022) along with extensive geographical data. By addressing these issues, the study aims to provide actionable insights that enhance the sustainability and cost-effectiveness of urban heating solutions.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"93b3d042ec92683397755ac2c6628797\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1255.9\n                    ],\n                    [\n                        104.4,\n                        1602.5\n                    ],\n                    [\n                        808.4,\n                        1602.5\n                    ],\n                    [\n                        808.4,\n                        1255.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95578,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"This study addresses several significant research gaps in the district heating field, particularly in integrating distributed heat sources into urban energy systems. First, traditional district heating studies have primarily focused on centralized heat production, overlooking the po- tential of distributed sources such as data centers, supermarkets, and water bodies. As a result, the significant untapped potential of residual heat from these sources has often been underutilized. Another critical gap is the reliance on coarse-resolution spatial and temporal data in previous studies, which limits the ability to capture urban heat supply and demand variability and dynamics. The lack of high-resolution data hampers the accuracy of supply\\u2013demand matching and the identifica- tion of optimal resource allocation.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"30edd9b49a0dffda34635ee5c3eec561\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.2,\n                        1604.8\n                    ],\n                    [\n                        103.2,\n                        1980.3\n                    ],\n                    [\n                        808.4,\n                        1980.3\n                    ],\n                    [\n                        808.4,\n                        1604.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95534,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Additionally, while the technical potential of distributed heat sour- ces has been well-documented, insufficient research has explored their economic viability in the context of current market conditions. This gap leaves policymakers without the necessary insights to make informed decisions about integrating these sources into existing infrastructure. Furthermore, previous studies have not fully leveraged advanced analytical approaches like machine learning algorithms. In particular, unsupervised learning methods, including K-means, DBSCAN, and Gaussian Mixture Models, have been underutilized in analyzing the complex spatial and temporal patterns of heat supply and demand. The lack of these advanced analytical techniques has constrained the ability to handle noise, non-linear distributions, and the scalability needed in urban energy analysis.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"67b6a2afe9d682d70b0cf3797644ca49\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        153.9\n                    ],\n                    [\n                        851.6,\n                        440.3\n                    ],\n                    [\n                        1555.6,\n                        440.3\n                    ],\n                    [\n                        1555.6,\n                        153.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95622,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"The limited use of localized analysis tailored to specific urban contexts has further hindered the recognition of their potential. Moreover, many studies fail to provide methodologies that can be replicated across different urban contexts, limiting the broader applicability of their findings. This lack of replicability impedes the widespread adoption of sustainable district heating solutions. Finally, a critical gap exists be- tween academic insights and the practical needs of urban planners and policymakers. Previous research has often failed to offer actionable recommendations, hindering the translation of academic findings into real-world applications.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"d47e7035c92c4a22c96f5a74dc36d29f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        445.6\n                    ],\n                    [\n                        851.6,\n                        556.5\n                    ],\n                    [\n                        1555.6,\n                        556.5\n                    ],\n                    [\n                        1555.6,\n                        445.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9392,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"By addressing these gaps, this study provides a high-resolution, economically grounded, and methodologically robust framework for integrating distributed heat sources into district heating networks, of- fering valuable insights for both researchers and urban planners.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"e60904400b39aa3d22728b8ef4d29142\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        594.2\n                    ],\n                    [\n                        851.6,\n                        616.3\n                    ],\n                    [\n                        1215.1,\n                        616.3\n                    ],\n                    [\n                        1215.1,\n                        594.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Literature review and background\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"b4fc8f979e576ddc33a55c45729cec0a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        648.2\n                    ],\n                    [\n                        851.6,\n                        1110.3\n                    ],\n                    [\n                        1555.6,\n                        1110.3\n                    ],\n                    [\n                        1555.6,\n                        648.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95272,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Blanco et al. [10] introduced a novel data-driven methodology for urban energy analysis by classifying urban areas into sixteen distinct morphological units called Urban Energy Units (UEUs). This approach utilizes open-source data and machine learning techniques, including a random forest model to address missing building data and a decision tree model for UEU classification. This data-driven method facilitates the creation of modular energy districts within cities, leading to more targeted and effective energy planning. Applied in Oldenburg, Germany, the methodology demonstrates the practical benefits of their classifica- tion system and underscores the importance of data-driven approaches in urban energy analysis for informed decision-making. Their study not only tackles the issue of missing data but also lays the groundwork for future research to validate and expand the classification framework to other urban areas. This work aligns with our studies, particularly in its application to district heating systems, highlighting the importance of data-driven approaches for informed energy planning.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"f74117011c5d864bf683da7aab40b605\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1114.4\n                    ],\n                    [\n                        851.6,\n                        1430.0\n                    ],\n                    [\n                        1555.6,\n                        1430.0\n                    ],\n                    [\n                        1555.6,\n                        1114.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95647,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Zhang et al. [11] tackle the critical issue of rising energy consump- tion in data centers, which has surged dramatically in recent years. The paper comprehensively reviews the latest thermal management tech- niques and evaluation metrics for data centers, discussing energy con- servation strategies and safe operation practices. It covers critical advancements in cooling technologies, innovative energy-saving methods such as free cooling and heat recovery, and optimization techniques to enhance system efficiency. The paper emphasizes the significance of thermal evaluation metrics in maintaining equipment safety and energy efficiency. It concludes by calling for further research and strategic development in the thermal management of data centers.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"e4d1f623c49036ad11bb31bdf203fdce\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1431.8\n                    ],\n                    [\n                        851.6,\n                        1749.5\n                    ],\n                    [\n                        1555.6,\n                        1749.5\n                    ],\n                    [\n                        1555.6,\n                        1431.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95545,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Wahlroos et al. [12] explore the potential of reusing waste heat from data centers in Nordic countries, highlighting both the challenges and opportunities. The paper addresses issues such as the lack of trans- parency in business models between district heating and data center operators and waste heat reuse\\u2019s economic and environmental impli- cations. Their proposed 8-step change process provides a structured approach to overcoming barriers, aligning closely with our project\\u2019s focus on waste heat management in data centers and district heating systems. The review emphasizes the importance of understanding en- ergy efficiency metrics and economic considerations directly relevant to our project\\u2019s objectives.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"3b4a4656a0548920f4b07d916105a422\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1752.8\n                    ],\n                    [\n                        851.6,\n                        1982.0\n                    ],\n                    [\n                        1555.6,\n                        1982.0\n                    ],\n                    [\n                        1555.6,\n                        1752.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95729,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Davies et al. [13] investigate the potential for reusing waste heat from data centers in London, focusing on using heat pumps to upgrade waste heat for district heating networks. The study reveals significant energy, carbon, and cost savings potential, especially when data center waste heat is integrated into district heating systems with eligibility for Renewable Heat Incentive (RHI) payments. It aligns potential waste heat sources with the heat demands of various London districts, demon- strating substantial energy and carbon savings benefits.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"5434f2f00339f3252797321c2ddae743\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1983.8\n                    ],\n                    [\n                        104.4,\n                        2061.5\n                    ],\n                    [\n                        808.4,\n                        2061.5\n                    ],\n                    [\n                        808.4,\n                        1983.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93514,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Another overlooked aspect is the role of data centers, which, despite their potential as significant heat sources, have often been underrepre-\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"bdb22a9c1d239d16e9b309232c3c29de\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        2045.4\n                    ],\n                    [\n                        104.4,\n                        2067.5\n                    ],\n                    [\n                        808.3,\n                        2067.5\n                    ],\n                    [\n                        808.3,\n                        2045.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"sented in district heating studies due to outdated or insufficient data.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"7ab260c57a3c2dbcb616e0c85849208a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1986.1\n                    ],\n                    [\n                        851.6,\n                        2069.2\n                    ],\n                    [\n                        1555.5,\n                        2069.2\n                    ],\n                    [\n                        1555.5,\n                        1986.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93522,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"Cichowicz et al. [14] compared Energy Performance Certificate (EPC) data calculation methods with actual energy consumption to evaluate energy efficiency in multi-family residential buildings. Their\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"8f885b23a47f48145b8a694b44240ac2\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        822.8,\n                        2107.0\n                    ],\n                    [\n                        822.8,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2107.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 2,\n            \"parent_id\": \"627b062139089deb49d744546fbf07c3\"\n        },\n        \"text\": \"2\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"395615d936b692d29f50176fcd31bfba\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1107.0,\n                        100.7\n                    ],\n                    [\n                        1107.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        100.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.49299,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3\n        },\n        \"text\": \"Energy Conversion and Management: X 25 (2025) 100860\",\n        \"type\": \"Header\"\n    },\n    {\n        \"element_id\": \"5bac0f2b5eb1a7e65fdbf4f570320c24\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        104.7\n                    ],\n                    [\n                        104.4,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"A. Shahcheraghian et al.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"ebb274977da44e30ff54c8f2fcc07806\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        153.2\n                    ],\n                    [\n                        104.4,\n                        353.0\n                    ],\n                    [\n                        808.4,\n                        353.0\n                    ],\n                    [\n                        808.4,\n                        153.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95397,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"findings revealed a 14.5 % difference in Practical Energy Consumption (PEC) indices and a 14.7 % difference in Final Energy (FE) indices be- tween the two methods. While both methods showed comparable per- formance, the reliance on user behavior in the consumption method raised concerns about its reliability across different building types. This study highlights the need for standardized procedures considering building-specific characteristics in EPC-based energy assessments.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"d1cc4e27342181989e2be3dbcc8c8561\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        356.0\n                    ],\n                    [\n                        104.4,\n                        754.1\n                    ],\n                    [\n                        808.4,\n                        754.1\n                    ],\n                    [\n                        808.4,\n                        356.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95538,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Zhang et al. [15] explore the evolution of district heating and cooling (DHC) systems in Sweden, focusing on adapting these systems to future changes in demand profiles and renewable energy supplies. Using a generalized methodology framework that integrates future changes, various operational scenarios, and system design optimizations, the study concludes that a fifth-generation district heating and cooling (5GDHC) system is the most economically viable option in a future scenario with low-energy building stock and increased cooling demand [16]. The study also highlights the significant impact of electricity prices on the cost-efficiency of 5GDHC and ultra-low temperature district heating and cooling (ULTDHC) systems, particularly with a 50 % share of wind power in the national grid. The methodology presented can be applied to similar systems to enhance understanding of system\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"137584aa643bef2709c4d43c2572fde3\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        151.4\n                    ],\n                    [\n                        851.6,\n                        643.6\n                    ],\n                    [\n                        1555.6,\n                        643.6\n                    ],\n                    [\n                        1555.6,\n                        151.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95444,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Union, and the increasing focus on energy efficiency driven by EU di- rectives. District Heating (DH) networks, covering 13 % of EU building heat loads, are evolving towards 4th Generation District Heating (4GDH), characterized by low-temperature heat distribution and renewable energy integration. The study identifies a gap in the literature regarding the application of unsupervised clustering techniques to heating demand data, unlike the extensive application in electricity demand analysis. The authors propose a multistep clustering framework using density-based clustering for outlier detection and k-means for identifying heating consumption patterns. The methodology reveals the interpretative challenges of clustering, as optimal classifications vary based on cluster validation indices (e.g., K = 3). While the framework offers valuable insights into demand patterns, its replicability remains limited. Future work aims to explore correlations between demand patterns and climatic or calendar variables and extend the framework\\u2019s application to additional buildings within the DH network to enhance generalizability and applicability.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"119b372972d8a31c270c47b20a240ce8\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        681.4\n                    ],\n                    [\n                        851.6,\n                        703.6\n                    ],\n                    [\n                        990.0,\n                        703.6\n                    ],\n                    [\n                        990.0,\n                        681.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Methodology\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"e1c4b1774a7551b1cf0237127f69a3b4\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        737.7\n                    ],\n                    [\n                        104.4,\n                        759.8\n                    ],\n                    [\n                        213.8,\n                        759.8\n                    ],\n                    [\n                        213.8,\n                        737.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"transitions.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"5b47f0dfe4b435de7efb30eab8d89f7d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.8,\n                        761.9\n                    ],\n                    [\n                        102.8,\n                        1217.8\n                    ],\n                    [\n                        808.4,\n                        1217.8\n                    ],\n                    [\n                        808.4,\n                        761.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95252,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Huang et al. [17] investigate the dual role of data centers in district energy systems, where they act as both consumers and producers of energy. The study reviews the integration of renewable energy and the recovery and reuse of waste heat in data centers, emphasizing the importance of optimizing both upstream and downstream processes. It discusses how upstream integration involves procuring and managing renewable energy sources, such as solar and wind, for data center op- erations. At the same time, downstream waste heat utilization refers to managing and repurposing waste heat for district heating systems. The findings indicate that while integrated global controls for managing energy production, operation, and waste heat generation are still developing, regional climate studies are crucial for optimizing these integrations. The study also highlights the development of global energy metrics as essential for quantifying data center performance and providing a comprehensive approach to sustainable energy use within\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ba8f36621a979228865970a1dc9c2808\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1202.7\n                    ],\n                    [\n                        104.4,\n                        1224.8\n                    ],\n                    [\n                        229.5,\n                        1224.8\n                    ],\n                    [\n                        229.5,\n                        1202.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"data centers.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"5af3681600348e6b3dcba65a9b6114c9\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1227.5\n                    ],\n                    [\n                        104.4,\n                        1544.4\n                    ],\n                    [\n                        808.4,\n                        1544.4\n                    ],\n                    [\n                        808.4,\n                        1227.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95685,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Su et al. [9] focus on decarbonizing Stockholm\\u2019s district heating sector to achieve net-zero emissions by 2040. They use an integrative GIS-based analysis to map clean, non-fossil fuel heat sources within Stockholm, achieving high-resolution mapping and addressing data availability challenges. Their results show that the city has abundant clean heat sources, including water bodies and data centers, capable of covering 100 % of the district\\u2019s heating net annual energy needs. The study identifies clusters of heat sources for prioritized exploitation. It provides a method pipeline applicable to other cities transitioning to clean district heating, emphasizing the importance of strategic planning based on local heat source availability.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"d7cb08251c42502e774948513d5ef7bb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.2,\n                        1546.9\n                    ],\n                    [\n                        103.2,\n                        2009.4\n                    ],\n                    [\n                        808.4,\n                        2009.4\n                    ],\n                    [\n                        808.4,\n                        1546.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95172,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Ogliari et al. [18] proposed a methodology integrating clustering and neural networks to enhance day-ahead thermal load forecasting for a District Heating (DH) system in Northern Italy. The study comprehen- sively addressed data preprocessing, variable correlation analysis, clustering, and forecasting. Three clustering techniques\\u2014k-means, Hi- erarchical Agglomerative Clustering (HAC), and DBSCAN\\u2014were eval- uated using the Cali\\u00b4nski-Harabasz and Silhouette indexes, identifying three optimal clusters while excluding outliers, but no single superior method emerged. Forecasting was explored using three strategies: training a single neural network for all utilities, per cluster (based on HAC), and per substation. Results indicated that training a neural network for each substation yielded the highest accuracy. However, a cluster-based approach was recommended for larger systems to balance accuracy and computational efficiency. The authors emphasized the need for further research with expanded datasets and additional sub- stations to validate and generalize their findings.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"3658d0c4de439581837b0a5d937415d1\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        2012.0\n                    ],\n                    [\n                        104.4,\n                        2067.5\n                    ],\n                    [\n                        808.4,\n                        2067.5\n                    ],\n                    [\n                        808.4,\n                        2012.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.90862,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Lumbreras et al. [19] highlight the critical role of the building sector, consuming approximately 40 % of primary energy in the European\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"c4ff4307cf645d706cdcd50905cff900\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        735.2\n                    ],\n                    [\n                        851.6,\n                        871.8\n                    ],\n                    [\n                        1557.2,\n                        871.8\n                    ],\n                    [\n                        1557.2,\n                        735.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94186,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The proposed method involves aggregating spatially labelled heat energy demand data with distributed heat sources, clustering these de- mands to map supply, and identifying optimal locations for new heat sources. Additionally, it includes calculating levelized heating costs by\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"67b874c18c8b86b2b10708fd92dba28f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        855.8\n                    ],\n                    [\n                        851.6,\n                        877.9\n                    ],\n                    [\n                        923.2,\n                        877.9\n                    ],\n                    [\n                        923.2,\n                        855.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"cluster.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"687ee8453cc3ffe3bed12a3bfdbb4b30\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        881.1\n                    ],\n                    [\n                        851.6,\n                        1075.5\n                    ],\n                    [\n                        1555.6,\n                        1075.5\n                    ],\n                    [\n                        1555.6,\n                        881.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95474,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Energy demand data is sourced from the Swedish Housing Author- ity\\u2019s (Boverket) Energy Performance Certificates (EPC) database and geographically located using data from the Swedish Survey Agency (Lantm\\u00a8ateriet) [20,21]. This database is merged with the locations of existing data centers, supermarkets, and water bodies, providing a comprehensive, multi-dimensional perspective for practical spatial\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"a8c777baff03ee3041f9958f0444dc77\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1059.1\n                    ],\n                    [\n                        851.6,\n                        1081.2\n                    ],\n                    [\n                        973.4,\n                        1081.2\n                    ],\n                    [\n                        973.4,\n                        1059.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"analysis [9].\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"93c69057ed14efd6e627dbb09109c472\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1084.6\n                    ],\n                    [\n                        851.6,\n                        1313.8\n                    ],\n                    [\n                        1556.4,\n                        1313.8\n                    ],\n                    [\n                        1556.4,\n                        1084.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9545,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The integration process synchronizes building-specific energy per- formance metrics with their geographical coordinates, ensuring that each data point accurately reflects both location and energy profile. Advanced clustering techniques, including k-means and agglomerative methods, are then employed to segment the region based on heat de- mand characteristics [22,23]. These clusters are analyzed to identify central nodes representing optimal locations for new data centers, considering their potential contributions to district heating systems.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"b9629cfe535d5b87c914a3a4f2a00745\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1316.9\n                    ],\n                    [\n                        851.6,\n                        1656.2\n                    ],\n                    [\n                        1555.6,\n                        1656.2\n                    ],\n                    [\n                        1555.6,\n                        1316.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95423,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The methodology ensures the optimal placement of new data centers within these identified clusters using quantitative metrics derived from k-means and agglomerative clustering analyses. These analyses leverage heat demand data from all buildings in Stockholm City. This approach allows for evaluating data center locations\\u2019 proximity to high-heat de- mand areas and their potential for integration into heat recovery sys- tems. It aligns with existing urban elements, such as supermarkets and water bodies, to enhance sustainable energy management. Ultimately, this method provides a data-driven framework for strategic urban planning and resource management, facilitating the development of district heating solutions that are both economically viable and envi-\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"bb2015ca89dd560ddd043f457c3ba492\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1640.3\n                    ],\n                    [\n                        851.6,\n                        1662.5\n                    ],\n                    [\n                        1092.9,\n                        1662.5\n                    ],\n                    [\n                        1092.9,\n                        1640.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"ronmentally sustainable.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"4e4731c791de5c558044d2293fa9fa54\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1665.1\n                    ],\n                    [\n                        851.6,\n                        2063.1\n                    ],\n                    [\n                        1555.6,\n                        2063.1\n                    ],\n                    [\n                        1555.6,\n                        1665.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95086,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The methodology for this analysis involves using Python for data processing and machine learning, with key libraries such as Pandas, NumPy, Scikit-learn, and Matplotlib. The simulation applies various clustering models, including K-means Clustering, Agglomerative Clus- tering, DBSCAN, Gaussian Mixture Models (GMM), and Spectral Clus- tering, to group the data based on features like heat demand, energy usage, and geographical locations. Visualizations are enhanced by overlaying geographical scatter plots with a background image, providing context for the clustering results. The dataset for Stockholm spans multiple years, with EPC (Energy Performance Certificate) data sizes for each year as follows: 10,368 data points for 2014, 39,320 for 2018, 42,566 for 2019, 28,830 for 2020, 14,304 for 2021, and 7,896 for 2022. The total dataset size across these years amounts to 143,284 data\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"bcefea05dac4b74489812e949795b855\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        2047.1\n                    ],\n                    [\n                        851.6,\n                        2069.2\n                    ],\n                    [\n                        1079.4,\n                        2069.2\n                    ],\n                    [\n                        1079.4,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"points. This dataset\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"c1e483b081d8d271f29ecdbb55aa34f5\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1094.8,\n                        2047.1\n                    ],\n                    [\n                        1094.8,\n                        2069.2\n                    ],\n                    [\n                        1282.9,\n                        2069.2\n                    ],\n                    [\n                        1282.9,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"includes detailed\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"ec678056b9978ec788ac3ec7e43d6ded\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1298.3,\n                        2047.1\n                    ],\n                    [\n                        1298.3,\n                        2069.2\n                    ],\n                    [\n                        1555.6,\n                        2069.2\n                    ],\n                    [\n                        1555.6,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"information on energy\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"7c6415690e9d21575b64a7ff59d45a38\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        822.8,\n                        2107.0\n                    ],\n                    [\n                        822.8,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2107.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 3,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"3\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"52bd5a473049b7f0fcce1b39cc079af6\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        104.7\n                    ],\n                    [\n                        104.4,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"A. Shahcheraghian et al.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"5bc2149ef8d6361f01d0fcf7899c8d3b\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1109.2,\n                        104.7\n                    ],\n                    [\n                        1109.2,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Energy Conversion and Management: X 25 (2025) 100860\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"482d45c9f73bc5e663b02d69bda15018\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.5,\n                        153.0\n                    ],\n                    [\n                        103.5,\n                        376.2\n                    ],\n                    [\n                        808.4,\n                        376.2\n                    ],\n                    [\n                        808.4,\n                        153.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95597,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"performance, property designation, and geographical coordinates, which are essential for clustering and analysis in the simulation. K- means Clustering serves as the primary solver in this environment, along with other unsupervised learning algorithms such as Agglomerative Clustering, DBSCAN, Gaussian Mixture Model (GMM), and Spectral Clustering. These clustering methods are employed to categorize the data based on key attributes, including heat demand, energy usage, and\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ca0b3cf95de3fec152c9b5b9a29009a4\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        153.3\n                    ],\n                    [\n                        851.6,\n                        353.0\n                    ],\n                    [\n                        1555.6,\n                        353.0\n                    ],\n                    [\n                        1555.6,\n                        153.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94879,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"of a building, was assigned to the nearest centroid based on the Euclidean distance between the data point\\u2019s features and the centroid\\u2019s features [25]. This assignment and recalculation of centroids were iteratively performed until the centroids stabilized, marking the algo- rithm\\u2019s convergence. As a result, the dataset was divided into four distinct clusters, each representing an area with homogeneous heat demand characteristics.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"285c981ed6794f5cc44a82792b92fb2d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        360.0\n                    ],\n                    [\n                        104.4,\n                        382.2\n                    ],\n                    [\n                        331.2,\n                        382.2\n                    ],\n                    [\n                        331.2,\n                        360.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"geographical locations.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"cfb8563e55626d3a680bc107fda51e2f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        385.6\n                    ],\n                    [\n                        104.4,\n                        498.4\n                    ],\n                    [\n                        808.3,\n                        498.4\n                    ],\n                    [\n                        808.3,\n                        385.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93714,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The dataset is comprised of both categorical and numerical attri- butes. To handle missing values, imputation and interpolation methods are applied. Additionally, the data is normalized to ensure it is properly scaled for effective clustering analysis.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"90f0464e31fd0e76f163923b4cb0ea0e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        356.1\n                    ],\n                    [\n                        851.6,\n                        527.4\n                    ],\n                    [\n                        1555.5,\n                        527.4\n                    ],\n                    [\n                        1555.5,\n                        356.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9509,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Concurrently, agglomerative clustering was employed as a hierar- chical method, starting with each data point as its own cluster. Clusters were merged based on their similarity and assessed using Ward\\u2019s method, which aims to minimize the variance within a cluster. This merging process continued until all data points were consolidated into four major clusters [26].\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"677b5d82d85635cc5f8c856928c3bc8b\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        535.1\n                    ],\n                    [\n                        104.4,\n                        557.3\n                    ],\n                    [\n                        634.3,\n                        557.3\n                    ],\n                    [\n                        634.3,\n                        535.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Processing of EPC data with Swedish survey agency data\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"6f05013086128b52c37233b37820c4a4\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        564.3\n                    ],\n                    [\n                        851.6,\n                        586.4\n                    ],\n                    [\n                        1193.4,\n                        586.4\n                    ],\n                    [\n                        1193.4,\n                        564.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Allocation of heat sources to clusters\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"dc31c46c6bdc609bbc0bf711013f7a07\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        590.7\n                    ],\n                    [\n                        104.4,\n                        667.9\n                    ],\n                    [\n                        808.4,\n                        667.9\n                    ],\n                    [\n                        808.4,\n                        590.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93125,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The EPC data was integrated with geographic information from the Swedish Survey Agency (Lantm\\u00a8ateriet) to identify optimal locations for\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"3fc88de53082dd3585b2692b6be8b313\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        651.5\n                    ],\n                    [\n                        104.4,\n                        673.7\n                    ],\n                    [\n                        751.7,\n                        673.7\n                    ],\n                    [\n                        751.7,\n                        651.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"future data centers based on heat demand characteristics [20,21].\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"aec7a3b974a9d73729a91b92ec79e9a0\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.9,\n                        678.0\n                    ],\n                    [\n                        103.9,\n                        964.2\n                    ],\n                    [\n                        808.4,\n                        964.2\n                    ],\n                    [\n                        808.4,\n                        678.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95499,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The data collection encompassed a wide array of energy metrics, categorized by energy types used for heating and domestic hot water (e. g., district heating, heating oil, natural gas, firewood, and various forms of electricity, including several types of heat pumps). These metrics were complemented by primary and normalized energy use figures for buildings, yielding a year-corrected value known as the Energy Index. Additional details included each building\\u2019s address, complexity, cate- gory, type, construction year, and structural specifics, such as the number of heated basement floors, above-ground floors, stairwells, and residential apartments.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ca5df8c0ed0447c086423089ab0b22ed\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        101.4,\n                        968.9\n                    ],\n                    [\n                        101.4,\n                        1080.4\n                    ],\n                    [\n                        808.3,\n                        1080.4\n                    ],\n                    [\n                        808.3,\n                        968.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93938,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"During integration, the energy performance data for each building was geocoded using primary and postal addresses, ensuring precise mapping. This accuracy is critical for practical spatial analysis, which underpins energy demand mapping and site selection for data centers.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"8ea8116c840cf3c57902a5820685c116\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.2,\n                        1083.9\n                    ],\n                    [\n                        102.2,\n                        1429.1\n                    ],\n                    [\n                        808.4,\n                        1429.1\n                    ],\n                    [\n                        808.4,\n                        1083.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95639,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"In the data processing phase, efforts were made to standardize and normalize the data across different energy types and measurement units, facilitating uniform analysis. Rigorous data cleansing was conducted to correct inconsistencies, impute or exclude missing values based on their significance, and eliminate duplicate records. This involved removing whitespace from string fields for consistency, extracting non-numeric prefixes from property designations and address identifiers to stan- dardize these fields, and handling missing values by removing rows with null entries. Additionally, coordinates were added based on property designations, and categorical variables were encoded using one-hot encoding. These steps ensured the dataset\\u2019s integrity and reliability for subsequent analysis.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"d61d8d98d41ced289978a3c89b5cf31f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        619.6\n                    ],\n                    [\n                        851.6,\n                        789.9\n                    ],\n                    [\n                        1555.6,\n                        789.9\n                    ],\n                    [\n                        1555.6,\n                        619.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95168,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"In the next step, k-means and agglomerative clustering were employed again, given their effectiveness in grouping data based on similarities, to identify clusters of Stockholm\\u2019s heat demands. To allo- cate existing renewable energy sources, Stockholm\\u2019s heat demands were segmented into ten districts using the k-means clustering algorithm, accessed via the sci-kit-learn library [25].\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"e9fd062ebbb3554c1b1cc25138bb2e6b\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        793.4\n                    ],\n                    [\n                        851.6,\n                        1051.3\n                    ],\n                    [\n                        1555.5,\n                        1051.3\n                    ],\n                    [\n                        1555.5,\n                        793.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9568,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The methodology begins by verifying and preparing the dataset, which includes critical analysis parameters. Data anomalies, such as infinite values or missing data points within the heat demand metric, are replaced with a statistically representative figure\\u2014typically the mean or median\\u2014to maintain data integrity. The heat demand data undergo a normalization process, ensuring a uniform scale for comparative visu- alization. The size of the visual markers is proportionally scaled to reflect the heat demand, enabling an accurate spatial representation of heat intensities.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"75fc3300b17192349771fed40dba6947\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1053.5\n                    ],\n                    [\n                        851.6,\n                        1196.6\n                    ],\n                    [\n                        1555.6,\n                        1196.6\n                    ],\n                    [\n                        1555.6,\n                        1053.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93593,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"For the clustering analysis, geographic coordinates are extracted to delineate the urban landscape into ten distinct zones. This segmentation is achieved through an iterative clustering technique that organizes the space based on proximity and similarity in heat demand, ensuring that the identified clusters are stable and replicable in subsequent analyses.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"c8855aa66eaadccd534080b906e6db10\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1200.4\n                    ],\n                    [\n                        851.6,\n                        1399.9\n                    ],\n                    [\n                        1555.5,\n                        1399.9\n                    ],\n                    [\n                        1555.5,\n                        1200.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95408,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Furthermore, the algorithm calculates the central points of these clusters, pinpointing critical areas of heat concentration. The final visualization includes a legend correlating to the clusters, with the geographic scope of the map meticulously adjusted to encompass the Stockholm region of interest. This comprehensive display of the city\\u2019s heat demand landscape is an indispensable tool for urban planning and the efficient allocation of energy resources.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"38dd2d760e263eaa2057ded2341ab2c7\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.7,\n                        1432.3\n                    ],\n                    [\n                        102.7,\n                        1574.4\n                    ],\n                    [\n                        808.4,\n                        1574.4\n                    ],\n                    [\n                        808.4,\n                        1432.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93511,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Through these processes, a robust and detailed spatial database was constructed to identify high-heat demand areas and determine the most strategic locations for future data center installations. This database not only supports detailed spatial analysis but also forms the foundation for the advanced clustering techniques used in the later stages of the study.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"9a05f629067567721662724461c5c03a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1611.2\n                    ],\n                    [\n                        104.4,\n                        1633.3\n                    ],\n                    [\n                        733.5,\n                        1633.3\n                    ],\n                    [\n                        733.5,\n                        1611.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Heat demand clustering using k-means and agglomerative clustering\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"6358f369223103112e6c10c1aac5fc52\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1665.6\n                    ],\n                    [\n                        104.4,\n                        1743.6\n                    ],\n                    [\n                        808.3,\n                        1743.6\n                    ],\n                    [\n                        808.3,\n                        1665.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93248,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"In this study phase, the geographical area was segmented into clus- ters based on buildings\\u2019 heat demand characteristics using k-means and\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"0016c5ff91a134f96fb0bd80070fc950\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1727.4\n                    ],\n                    [\n                        104.4,\n                        1749.5\n                    ],\n                    [\n                        464.8,\n                        1749.5\n                    ],\n                    [\n                        464.8,\n                        1727.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"agglomerative clustering techniques.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"5d91f4d7702da3643d693d33df07750b\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1436.9\n                    ],\n                    [\n                        851.6,\n                        1459.0\n                    ],\n                    [\n                        1050.9,\n                        1459.0\n                    ],\n                    [\n                        1050.9,\n                        1436.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Marginal cost of heat\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"2cf44d06a7170632ae4a074c3714562f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1490.7\n                    ],\n                    [\n                        851.6,\n                        1772.8\n                    ],\n                    [\n                        1555.5,\n                        1772.8\n                    ],\n                    [\n                        1555.5,\n                        1490.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95692,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The economic impact of waste heat recovery is evaluated using the marginal cost of heat (MCOH), primarily driven by electricity prices and limited to operational costs. This focus on operational costs is due to the relatively minor contribution of capital costs to the overall life cycle cost. The capital costs for heat recovery equipment are conservatively estimated at \\u20ac1.5 million per MW of cooling capacity [27\\u201329], repre- senting about 3 % of the operational cost for a single year. Over a 20- year lifespan with a 10 % discount rate, capital costs account for only 0.3 % of the total life cycle cost, which falls well within the range of\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"837968535006d4f590ebd8400bc87aee\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.3,\n                        1752.9\n                    ],\n                    [\n                        103.3,\n                        2011.1\n                    ],\n                    [\n                        808.4,\n                        2011.1\n                    ],\n                    [\n                        808.4,\n                        1752.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95569,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"The Elbow Method was utilized to determine the optimal number of clusters for k-means clustering. This method plots the sum of squared distances (inertia) from each point to its assigned cluster center against the number of clusters. As the number of clusters increases, inertia de- creases. However, there is a point where the rate of decrease sharply slows, forming an \\u201celbow\\u201d shape on the plot. This \\u201celbow\\u201d indicates the optimal number of clusters, balancing the trade-off between underfitting and overfitting. Employing the Elbow Method ensured that the seg- mentation was meaningful and efficient for further analysis [24].\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"fa4f6b2a0e4b4b1299a6d843c2fddeb3\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        1756.6\n                    ],\n                    [\n                        851.7,\n                        1778.7\n                    ],\n                    [\n                        1070.5,\n                        1778.7\n                    ],\n                    [\n                        1070.5,\n                        1756.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"economic uncertainty.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"41da32e505d8eab514fe230a44e027b3\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        1781.1\n                    ],\n                    [\n                        851.7,\n                        2004.7\n                    ],\n                    [\n                        1555.6,\n                        2004.7\n                    ],\n                    [\n                        1555.6,\n                        1781.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95349,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Although capital costs are not insignificant, they are less critical in this context. Previous studies have indicated that economic returns for data center [27] and supermarket [30] owners are uncertain, partly due to the variable value of heat throughout the year and the network owner\\u2019s willingness to pay for it [25]. This study adopts the perspective of the district and city, viewing waste and environmental heat as part of a resource portfolio where the lowest marginal costs determine the merit\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"e67b2fd41023b5baac00392d61f8b24e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        1989.0\n                    ],\n                    [\n                        851.7,\n                        2011.1\n                    ],\n                    [\n                        910.5,\n                        2011.1\n                    ],\n                    [\n                        910.5,\n                        1989.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"order.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"0b2f0868d6dfe1683cb5d5cf7ef51095\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.7,\n                        2014.3\n                    ],\n                    [\n                        103.7,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        2014.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.90689,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Subsequently, four centroids were selected within the dataset for the k-means clustering process. Each data point, representing the heat data\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"d988a06cd27eb224633f7d31e1636264\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        852.2,\n                        2014.4\n                    ],\n                    [\n                        852.2,\n                        2064.1\n                    ],\n                    [\n                        1555.5,\n                        2064.1\n                    ],\n                    [\n                        1555.5,\n                        2014.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.91628,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"For cooling devices and heat pumps, the MCOH is entirely influenced\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"fbf57d2de4e70d668144b46ad9d721bb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        2047.1\n                    ],\n                    [\n                        851.7,\n                        2070.4\n                    ],\n                    [\n                        1555.5,\n                        2070.4\n                    ],\n                    [\n                        1555.5,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"by the coefficient of performance (COP) and the price of electricity (pel),\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"84029eb2ce14f0a26af61bd29ebd747e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        822.8,\n                        2107.0\n                    ],\n                    [\n                        822.8,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2107.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 4,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"4\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"119c22eac56fe8ad4717c993235d5124\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        104.7\n                    ],\n                    [\n                        104.4,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"A. Shahcheraghian et al.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"339c2e28a1a0bce260d3bc54db598309\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1109.2,\n                        104.7\n                    ],\n                    [\n                        1109.2,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"Energy Conversion and Management: X 25 (2025) 100860\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"60de7b9e1fa37c3db3e6d766fe0e0291\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        100.0,\n                        154.4\n                    ],\n                    [\n                        100.0,\n                        207.8\n                    ],\n                    [\n                        808.3,\n                        207.8\n                    ],\n                    [\n                        808.3,\n                        154.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.92061,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5,\n            \"parent_id\": \"395615d936b692d29f50176fcd31bfba\"\n        },\n        \"text\": \"as represented by Eq. (1). Maintenance costs, like capital costs, are also considered negligible and are therefore excluded from the analysis.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"2a3cfbb0176d73314c56bfa94545a71d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        224.0\n                    ],\n                    [\n                        104.4,\n                        276.3\n                    ],\n                    [\n                        809.7,\n                        276.3\n                    ],\n                    [\n                        809.7,\n                        224.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.69912,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"partial\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"MCOH = pel COP [\\u20ac/MWh] (1)\",\n        \"type\": \"Formula\"\n    },\n    {\n        \"element_id\": \"d1a99cb26638c41f5c89bb91ecaded44\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.6,\n                        289.3\n                    ],\n                    [\n                        102.6,\n                        576.5\n                    ],\n                    [\n                        808.4,\n                        576.5\n                    ],\n                    [\n                        808.4,\n                        289.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95725,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Electricity prices and COPs fluctuate throughout the year, as does heat value, making detailed hourly simulations the most effective method for assessing cost-effectiveness at any given time [30,31]. However, high-resolution time simulations are beyond the scope of this study. Instead, an economic performance map is created to capture a range of COPs and electricity prices. This map includes cost ranges for data centers, supermarkets, and water bodies, comparing them to Stockholm\\u2019s district heating prices at retail and wholesale levels. Wholesale prices are derived from Stockholm Exergi\\u2019s 2024 base retail prices [32] and their Open District Heating (ODH) market [33].\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"337d690f069327a37cc3f30a7b52724f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        581.8\n                    ],\n                    [\n                        104.4,\n                        808.9\n                    ],\n                    [\n                        808.4,\n                        808.9\n                    ],\n                    [\n                        808.4,\n                        581.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95331,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Equation (2) provides the formula for calculating the weighted MCOH for each district or cluster. Each cluster is denoted as i, and the MCOH of each heat source (with each technology denoted as j) is multiplied by the heat supply for each source in the cluster portfolio (Qj, i), then divided by the total heat demand of the cluster (Qi). This analysis reveals spatial differences in heating costs across the city, which can significantly influence urban development, particularly in cities lacking district heating networks.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"5b1ef61818eb75e0dbb65d517b39bc16\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        203.8,\n                        809.1\n                    ],\n                    [\n                        203.8,\n                        839.4\n                    ],\n                    [\n                        243.8,\n                        839.4\n                    ],\n                    [\n                        243.8,\n                        809.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"\\u2211(\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"c7aa1558f419b0e0c3db63b4f437e50f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        344.1,\n                        809.1\n                    ],\n                    [\n                        344.1,\n                        831.2\n                    ],\n                    [\n                        357.2,\n                        831.2\n                    ],\n                    [\n                        357.2,\n                        809.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \")\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"fe3797aef9c57357be6efb908e76c04d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.1,\n                        829.2\n                    ],\n                    [\n                        103.1,\n                        899.5\n                    ],\n                    [\n                        820.6,\n                        899.5\n                    ],\n                    [\n                        820.6,\n                        829.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.83196,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"partial\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"MCOHi = pel,j/SCOPj Qi Qj,i [\\u20ac/MWh] (2)\",\n        \"type\": \"Formula\"\n    },\n    {\n        \"element_id\": \"d4fc5235dc36fca9bd6ca65f07908478\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        942.9\n                    ],\n                    [\n                        104.4,\n                        965.0\n                    ],\n                    [\n                        497.5,\n                        965.0\n                    ],\n                    [\n                        497.5,\n                        942.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Hyperparameter selection and justification\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"87de740d46f47f365aca5fb1fa626fa6\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        100.8,\n                        1000.0\n                    ],\n                    [\n                        100.8,\n                        1546.2\n                    ],\n                    [\n                        808.4,\n                        1546.2\n                    ],\n                    [\n                        808.4,\n                        1000.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94845,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"The hyperparameters listed in Table 1 are critical for selecting the optimal values for various clustering algorithms used in the study. In the case of KMeans (n_clusters = 4), this value was chosen based on the assumption that the data can be divided into distinct groups, such as high-demand versus low-demand heat zones. Selecting four clusters enables the identification of several types of demand and supply loca- tions, representing different heating demand profiles across the city. The Elbow Method was employed to determine the ideal number of clusters by evaluating the sum of squared distances within clusters. A smaller number of clusters, such as two or three, would oversimplify the data, while more clusters could overfit the model and introduce noise, making four clusters an ideal balance for spatial clustering in district heating. Similarly, Agglomerative Clustering (n_clusters = 4) was selected to partition the dataset into distinct heat supply and demand regions, with the number of clusters adjusted based on the dendrogram, which visu- ally represents hierarchical relationships. Choosing fewer clusters could obscure subtle spatial patterns, while more clusters might increase complexity and risk overfitting, making four clusters a reasonable choice.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"c6610a8d341ff3b0d14f4adec6acb764\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        100.5,\n                        1547.4\n                    ],\n                    [\n                        100.5,\n                        2061.8\n                    ],\n                    [\n                        808.4,\n                        2061.8\n                    ],\n                    [\n                        808.4,\n                        1547.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94923,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"For DBSCAN (eps = [0.1, 0.3, 0.5, 0.7, 1.0], min_samples = [3,5,10,15]), the parameter eps controls the maximum distance between two points to be considered part of the same neighborhood. A range of values from 0.1 to 1.0 was selected to explore different neighborhood sizes, which is crucial for identifying tightly packed clusters (small eps values) or more spread-out ones (larger eps values). The min_samples parameter determines the minimum number of points required to form a \\u201ccore\\u201d point in a neighborhood. Smaller values (e.g., 3) lead to the identification of more clusters, while larger values (e.g., 10 or 15) focus on denser, more meaningful clusters. This approach ensures the algo- rithm can handle spatial data with varying densities, such as urban heat sources, and avoid noise. SpectralClustering (n_clusters = 4, affinity = \\u2019nearest_neighbors\\u2019, random_state = 42) was chosen to focus on local spatial structures by using the \\u2019nearest_neighbors\\u2019 affinity, which is critical for clustering heat demand or supply based on geographical proximity. Fixing the random state ensures reproducibility of the results, which is essential for research purposes. The number of clusters affects\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"5b63db85ecae1eaf58b5717c03c323d2\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        158.6\n                    ],\n                    [\n                        851.7,\n                        178.5\n                    ],\n                    [\n                        927.5,\n                        178.5\n                    ],\n                    [\n                        927.5,\n                        158.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Table 1\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"6f4c9b3089f0cb020e772cff3e3d6dcb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        857.4,\n                        178.9\n                    ],\n                    [\n                        857.4,\n                        1325.5\n                    ],\n                    [\n                        1537.7,\n                        1325.5\n                    ],\n                    [\n                        1537.7,\n                        178.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.86763,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"image_path\": \"artifacts/images/table-5-1.jpg\",\n            \"is_extracted\": \"partial\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Algorithm KMeans Hyperparameter n_clusters Value/Range 4 Description Number of clusters Agglomerative Clustering n_clusters 4 to form. Number of clusters to form. DBSCAN eps [0.1, 0.3, 0.5, 0.7, The maximum Clustering 1.0] distance between two samples for them to be considered as in the same neighborhood. min_samples [3,5,10,15] The number of samples in a neighborhood for a point to be considered as a core point. Spectral n_clusters 4 Number of clusters Clustering random_state 42 to form. Seed used by the random number generator for reproducibility. Gaussian Mixture affinity n_components \\u2019nearest_neighbors\\u2019 4 Metric used to compute the similarity matrix. The number of mixture components Clustering (clusters). covariance_type \\u2019full\\u2019 Type of covariance matrix. Options: \\u2019full\\u2019, \\u2019tied\\u2019, \\u2019diag\\u2019, \\u2019spherical\\u2019. reg_covar 1.00E-04 Regularization to ensure covariance matrices are positive semi-definite. max_iter 500 Maximum number Data Preprocessing imputer_strategy \\u2019mean\\u2019 of iterations. Strategy to use for imputing missing values. scaler StandardScaler Standardizes the data by removing the mean and scaling to unit\",\n        \"type\": \"Table\"\n    },\n    {\n        \"element_id\": \"93c820cd958a58d8b2f4653d1ba55804\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.7,\n                        185.2\n                    ],\n                    [\n                        851.7,\n                        205.1\n                    ],\n                    [\n                        1318.1,\n                        205.1\n                    ],\n                    [\n                        1318.1,\n                        185.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Hyperparameter Selection for Clustering Algorithms.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"0af95e9fe6c059dba90ea21a59e1c30d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1372.9,\n                        1330.5\n                    ],\n                    [\n                        1372.9,\n                        1348.2\n                    ],\n                    [\n                        1444.5,\n                        1348.2\n                    ],\n                    [\n                        1444.5,\n                        1330.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"variance.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"3ff7ec2fb2cf0db20038c2c027e3c350\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1398.8\n                    ],\n                    [\n                        851.6,\n                        1425.1\n                    ],\n                    [\n                        1159.0,\n                        1425.1\n                    ],\n                    [\n                        1159.0,\n                        1398.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"heat demand\\u2013supply matching.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"a9cbe6c45054343a6e33d4c35c0fe976\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1426.4\n                    ],\n                    [\n                        851.6,\n                        1773.8\n                    ],\n                    [\n                        1555.6,\n                        1773.8\n                    ],\n                    [\n                        1555.6,\n                        1426.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95648,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"For GaussianMixture (n_components = 4, covariance_type = \\u2018full\\u2019, reg_covar = le-4, max iter = 500), the number of components was set to 4 to model the heat sources in Stockholm as a combination of four distinct distributions, each representing different heating profiles. The *full\\u2019 covariance type was selected to allow each component to have its own covariance matrix, offering maximum data modeling flexibility. Regularization (reg covar = 1e\\u20144) ensures the covariance matrices are positive semi-definite, which enhances model stability, especially with sparse data. The max iter parameter was set to 500 to allow the algo- rithm sufficient time to converge to an optimal model. Fewer compo- nents may simplify the model, losing important detail, while more components could overfit the data.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"a4d9d31d8cd7102244a30dfb93c38489\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1775.9\n                    ],\n                    [\n                        851.6,\n                        2057.6\n                    ],\n                    [\n                        1555.6,\n                        2057.6\n                    ],\n                    [\n                        1555.6,\n                        1775.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95469,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"Data preprocessing choices included imputing missing values using the mean strategy (imputer_strategy = \\u2019mean\\u2019) and standardizing the data with StandardScaler. The mean imputation was chosen because it is a simple and effective strategy for handling missing data, particularly when the data is missing at random. Standardizing the data ensures that all features contribute equally to the clustering process by eliminating bias from features with more extensive ranges, such as geographical coordinates or temperature values. Other imputation strategies or scaling methods could be considered, but standard scaling is typically\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"7038721be06b317774a8525df29de771\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        2047.1\n                    ],\n                    [\n                        104.4,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"the granularity of the identified patterns, influencing the resolution of\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"704996a533ebad4f7d5a63b1415323df\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        2042.2\n                    ],\n                    [\n                        851.6,\n                        2064.4\n                    ],\n                    [\n                        1549.0,\n                        2064.4\n                    ],\n                    [\n                        1549.0,\n                        2042.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 5\n        },\n        \"text\": \"ideal for clustering tasks, as it normalizes the influence of each feature.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"8111f4ffe6e3043e82b136a17b68aabe\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        822.8,\n                        2107.0\n                    ],\n                    [\n                        822.8,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2107.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n         