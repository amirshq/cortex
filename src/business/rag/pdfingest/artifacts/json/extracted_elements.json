                    ],\n                    [\n                        1546.7,\n                        209.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93918,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"image_path\": \"artifacts/images/table-6-2.jpg\",\n            \"is_extracted\": \"partial\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Year Total EPCs EPC and Coordinates Match Rate 2014\\u20132017 2018 5583 4258 1999 3324 36 % 78 % 2019 4931 2651 54 % 2020 4867 2715 56 % 2021 2022 5696 6054 1886 1528 33 % 25 % Totals 31,389 14,103 45 %\",\n        \"type\": \"Table\"\n    },\n    {\n        \"element_id\": \"617c41da870289de254331219dd1f360\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        506.6\n                    ],\n                    [\n                        104.4,\n                        528.8\n                    ],\n                    [\n                        278.2,\n                        528.8\n                    ],\n                    [\n                        278.2,\n                        506.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Methods limitation\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"cdad854f95246cf494a52a297be5a22a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        510.1\n                    ],\n                    [\n                        851.6,\n                        563.7\n                    ],\n                    [\n                        1555.6,\n                        563.7\n                    ],\n                    [\n                        1555.6,\n                        510.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.89857,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"future data centers, enabling a more strategic and data-driven approach to district heating planning.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"90025f819e1b86dafc3fda7ff9364179\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        100.6,\n                        560.3\n                    ],\n                    [\n                        100.6,\n                        906.6\n                    ],\n                    [\n                        808.4,\n                        906.6\n                    ],\n                    [\n                        808.4,\n                        560.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95558,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"While the proposed methodology offers a comprehensive framework for optimizing heat resource allocation in urban environments, it has certain limitations. Any inaccuracies, missing entries, or outdated in- formation can directly impact the clustering results and the overall ac- curacy of heat demand mapping. Additionally, the methodology assumes standardization across various energy types and units, which may not fully capture regional variations or temporal fluctuations in heat demand and supply. The clustering techniques used, such as k- means and agglomerative clustering, depend on the selection of hyper- parameters, like the number of clusters, which can be somewhat sub- jective and may not fully reflect the complex spatial dynamics of urban heat demand.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ba344e54dc1940e091a9ba4afb7e6af5\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.4,\n                        908.4\n                    ],\n                    [\n                        103.4,\n                        1255.2\n                    ],\n                    [\n                        808.4,\n                        1255.2\n                    ],\n                    [\n                        808.4,\n                        908.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95544,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Another significant limitation is the simplified economic model used for evaluating the marginal cost of heat (MCOH). By focusing primarily on operational costs and assuming that capital and maintenance costs are negligible, the methodology may overlook important economic factors influencing the feasibility of integrating new heat sources. Moreover, the method does not account for practical challenges such as policy constraints, stakeholder engagement, and the adaptability to real- time changes in heat demand or supply. These factors can significantly impact the implementation of the proposed solutions in real-world urban settings. Addressing these limitations is essential for enhancing the robustness and applicability of the methodology in diverse urban contexts.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"6c5351d9d4e2b6f27c74c65154b06fb9\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1291.7\n                    ],\n                    [\n                        104.4,\n                        1313.8\n                    ],\n                    [\n                        180.8,\n                        1313.8\n                    ],\n                    [\n                        180.8,\n                        1291.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Results\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"24698e59446f06990949490af8b5bbfe\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        99.3,\n                        1345.0\n                    ],\n                    [\n                        99.3,\n                        1865.8\n                    ],\n                    [\n                        808.4,\n                        1865.8\n                    ],\n                    [\n                        808.4,\n                        1345.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95048,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"In this research, the marginal cost of environmental heat was assessed locally to determine its impact on the merit order of heat deployment and the resulting cost to the city. The heat demand across Stockholm was mapped using data from the Energy Performance Cer- tificate (EPC) database, which was integrated with property locations provided by the Swedish Land Survey (Lantm\\u00a8ateriet). After removing duplicate property description entries (known as \\u2019fastighetsbeteckning\\u2019 in Swedish), the number of unique properties in the EPC and Lantm\\u00a8ateriet datasets are 31,389 and 61,952, respectively. When the EPCs are filtered for those connected to district heating (approximately 52 % of all buildings and 92 % of the floor area in Stockholm) and cross- referenced for matching property descriptions, there are 14,103 entries. This is 86 % of all DH connected properties. However, the total demand is found to be 7.7 TWh/year and is in agreement with prior studies [34]. The breakdown by year of record for EPCs and matching properties with coordinates are given in Table 2 and shown spatially in Fig. 1. Table 2 shows Unique total property counts for EPCs and those with coordinates by year.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"9f47e0c5fa6ad7f5587d5596fe208362\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        102.6,\n                        1867.6\n                    ],\n                    [\n                        102.6,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        2069.2\n                    ],\n                    [\n                        808.4,\n                        1867.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94897,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"A heat map was created to further illustrate the spatial distribution and intensity of heat demand, as shown in Fig. 2. This heat map visu- alizes the density of heat demand data points across Stockholm, using the x and y coordinates to represent longitude and latitude. Lighter, more saturated areas on the map indicate regions with greater heat demand, clearly highlighting areas where heat resources are most needed. This visualization is crucial for identifying optimal locations for\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"3c10b207b1caccf3fed256e8d4c8b338\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        619.6\n                    ],\n                    [\n                        851.6,\n                        668.6\n                    ],\n                    [\n                        1477.1,\n                        668.6\n                    ],\n                    [\n                        1477.1,\n                        619.6\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.89921,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Allocation of future data centers using k-means and agglomerative\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"8b6eccfbb873f614e14b5194f2115905\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        652.3\n                    ],\n                    [\n                        851.6,\n                        674.4\n                    ],\n                    [\n                        938.9,\n                        674.4\n                    ],\n                    [\n                        938.9,\n                        652.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"clustering\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"2e35250cfc33c7680229125a058b3a5f\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        707.0\n                    ],\n                    [\n                        851.6,\n                        1110.3\n                    ],\n                    [\n                        1555.6,\n                        1110.3\n                    ],\n                    [\n                        1555.6,\n                        707.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95338,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Fig. 3 offers a comprehensive visualization of the spatial distribution of heat demands across Stockholm, with intensity levels represented by the size and colour of the circles. Larger and darker circles indicate areas of higher heat demand, helping to identify critical zones with concen- trated energy requirements. Five advanced clustering techniques\\u2014K- Means, Agglomerative Clustering, DBSCAN, Spectral Clustering, and Gaussian Mixture Model (GMM)\\u2014were applied to determine the optimal locations for future data centers. Each clustering method is represented on the map, with K-Means cluster centers marked by red triangles, Agglomerative cluster centers by blue stars, DBSCAN cluster centers by blue cross, Spectral Clustering centers by purple circles, and Gaussian Mixture Model centers by green squares. This multi-method approach ensures a robust and reliable analysis, enhancing confidence in the recommended locations for data centers.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"014d5b236c8d4a425ab5cc5028e73fa5\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1113.0\n                    ],\n                    [\n                        851.6,\n                        1459.0\n                    ],\n                    [\n                        1555.6,\n                        1459.0\n                    ],\n                    [\n                        1555.6,\n                        1113.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95222,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"The clustering analysis reveals that Stockholm\\u2019s highest heat de- mand concentrations are located primarily in its central and northern regions, as evident from the denser and darker circles in these areas. Each clustering method provided unique insights into the spatial dis- tribution of heat demand. K-means and Agglomerative Clustering consistently overlapped, demonstrating their reliability in identifying high-demand zones. DBSCAN excelled in identifying smaller, denser clusters, highlighting micro-level variations in heat demand. Spectral Clustering and GMM offered additional perspectives by identifying flexible cluster shapes and providing probabilistic clusters, respectively. These nuances help refine the decision-making process and broaden the scope of infrastructure planning.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ff2e1587389ba41b0ad1e538948a8aa1\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1461.3\n                    ],\n                    [\n                        851.6,\n                        2033.2\n                    ],\n                    [\n                        1555.6,\n                        2033.2\n                    ],\n                    [\n                        1555.6,\n                        1461.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.94478,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"Each of the five clustering methods brings unique strengths and perspectives to the analysis, offering a comprehensive understanding of heat demand patterns in Stockholm. K-Means Clustering provides a simple and efficient solution for partitioning data into well-defined clusters, though its assumption of spherical and similarly sized clusters may not always reflect the actual spatial distribution. Agglomerative Clustering effectively captures hierarchical relationships and yields flexible, interpretable cluster shapes, but it can become computationally intensive and less scalable than K-Means. DBSCAN excels at identifying dense regions of heat demand and uncovering smaller clusters that other methods may overlook, yet it struggles with sparse data and is highly sensitive to parameter choices. Spectral Clustering accommodates complex, non-linear cluster shapes, making it ideal for intricate spatial patterns, although it is computationally expensive and sensitive to the prescribed number of clusters. Finally, the Gaussian Mixture Model (GMM) offers probabilistic clusters with nuanced boundaries that facilitate uncertainty quantification, but its performance may hinge on initial conditions and extensive parameter tuning. Together, these methods provide a robust toolkit for exploring, analyzing, and inter-\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"5e35d5e626209048e029dd7c85a89a95\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        2018.0\n                    ],\n                    [\n                        851.6,\n                        2040.1\n                    ],\n                    [\n                        1440.8,\n                        2040.1\n                    ],\n                    [\n                        1440.8,\n                        2018.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"preting the spatial variability of heat demand in Stockholm.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"6af21493c1a2d302e38973c1b7e529d0\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        884.9,\n                        2047.1\n                    ],\n                    [\n                        884.9,\n                        2069.2\n                    ],\n                    [\n                        1555.6,\n                        2069.2\n                    ],\n                    [\n                        1555.6,\n                        2047.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"No single method is universally superior. Instead, using multiple\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"13e9107e64e8d98840ef6fe750bee1ad\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        822.8,\n                        2107.0\n                    ],\n                    [\n                        822.8,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2124.7\n                    ],\n                    [\n                        838.0,\n                        2107.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 6\n        },\n        \"text\": \"6\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"a9395384ca55943ad800864155dcc0bb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        104.7\n                    ],\n                    [\n                        104.4,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        122.4\n                    ],\n                    [\n                        1399.3,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"A. Shahcheraghian et al.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"4fce60b66665b9d92cab1726fdf9c8bb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        1109.2,\n                        104.7\n                    ],\n                    [\n                        1109.2,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        122.5\n                    ],\n                    [\n                        1556.0,\n                        104.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"Energy Conversion and Management: X 25 (2025) 100860\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"c492586fb6f61717d39b96a5baf5f8b0\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        215.1,\n                        153.9\n                    ],\n                    [\n                        215.1,\n                        1048.8\n                    ],\n                    [\n                        1438.5,\n                        1048.8\n                    ],\n                    [\n                        1438.5,\n                        153.9\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"image_path\": \"artifacts/images/figure-7-4.jpg\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"2020 2021 2022\",\n        \"type\": \"Image\"\n    },\n    {\n        \"element_id\": \"7481d848d8679db1952b32f4dc23bb5d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1075.5\n                    ],\n                    [\n                        104.4,\n                        1126.4\n                    ],\n                    [\n                        1554.9,\n                        1126.4\n                    ],\n                    [\n                        1554.9,\n                        1075.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.85364,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"Fig. 1. Unique buildings/properties in Stockholm (blue dots) compared with properties that have energy data (Red dots). (For interpretation of the references to color in this figure legend, the reader is referred to the web version of this article.)\",\n        \"type\": \"FigureCaption\"\n    },\n    {\n        \"element_id\": \"9a56809d6d7c0048baeb96968da217cc\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1163.3\n                    ],\n                    [\n                        104.4,\n                        1393.0\n                    ],\n                    [\n                        808.4,\n                        1393.0\n                    ],\n                    [\n                        808.4,\n                        1163.3\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95461,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"methods enriches the analysis by capturing different aspects of the data. For instance, DBSCAN effectively detects localized high-demand clus- ters, while GMM offers a probabilistic perspective that accounts for variations within the data. The overlaps between K-Means and Agglomerative Clustering provide consistent insights, reinforcing the reliability of their suggested locations. With its ability to handle non- linear patterns, Spectral Clustering complements the other methods by uncovering additional potential sites.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"0994fb5825bdb5e9f783f056b57fce7e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        110.2,\n                        1396.4\n                    ],\n                    [\n                        110.2,\n                        1444.3\n                    ],\n                    [\n                        801.9,\n                        1444.3\n                    ],\n                    [\n                        801.9,\n                        1396.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.91303,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"Table 3 provides a numerical comparison of the cluster center loca-\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"2e279f58dc50640a15c624d71d676b70\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.4,\n                        1429.0\n                    ],\n                    [\n                        104.4,\n                        1451.1\n                    ],\n                    [\n                        422.5,\n                        1451.1\n                    ],\n                    [\n                        422.5,\n                        1429.0\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"tions identified by each method.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"f85044cddea7aa84504cc8ed62e65c57\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        104.3,\n                        1454.5\n                    ],\n                    [\n                        104.3,\n                        1741.7\n                    ],\n                    [\n                        808.4,\n                        1741.7\n                    ],\n                    [\n                        808.4,\n                        1454.5\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95635,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"The clustering results indicate that while K-Means and Agglomera- tive Clustering tend to converge on similar cluster centers, DBSCAN, Spectral Clustering, and GMM identify additional or alternative loca- tions. This divergence underscores the value of employing multiple clustering techniques to capture global and local data patterns. DBSCAN highlighted micro-level heat demand variations that could be critical for localized planning. Spectral Clustering uncovered complex patterns, suggesting potential sites near existing infrastructures. GMM, with its probabilistic approach, provided insights into areas of uncertainty, enabling more informed decision-making.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"4ac872a60934eb49f550ae9949cadb3a\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1163.1\n                    ],\n                    [\n                        851.6,\n                        1328.4\n                    ],\n                    [\n                        1555.6,\n                        1328.4\n                    ],\n                    [\n                        1555.6,\n                        1163.1\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95083,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"heat demand patterns. Smaller but strategically important pockets of demand might not significantly influence the cluster centroids and could be overlooked. To address these limitations, clustering results should be complemented with predictive models, urban planning considerations, stakeholder engagement, and adaptive strategies to accommodate future\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"3580a6ae6f3056936d4e1dfc65eaa693\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1312.8\n                    ],\n                    [\n                        851.6,\n                        1334.9\n                    ],\n                    [\n                        936.0,\n                        1334.9\n                    ],\n                    [\n                        936.0,\n                        1312.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"changes.\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"b3e5bf1746fc9899c41f70479d2a260d\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1337.2\n                    ],\n                    [\n                        851.6,\n                        1654.4\n                    ],\n                    [\n                        1555.6,\n                        1654.4\n                    ],\n                    [\n                        1555.6,\n                        1337.2\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.9572,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"By leveraging five advanced clustering methods\\u2014K-Means, Agglomerative Clustering, DBSCAN, Spectral Clustering, and GMM\\u2014this analysis provides a comprehensive understanding of heat demand patterns in Stockholm. The multi-method approach not only identifies optimal locations for future data centers but also highlights the strengths and limitations of each technique. Integrating these insights with urban planning strategies ensures a balanced, data-driven, and adaptive approach to sustainable energy solutions. This methodology demonstrates the potential for clustering techniques to guide the development of efficient district heating systems, supporting Stock- holm\\u2019s broader sustainability goals.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"ddec35b97de4fc956c101f7206dfed9e\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        851.6,\n                        1698.4\n                    ],\n                    [\n                        851.6,\n                        1720.6\n                    ],\n                    [\n                        1193.4,\n                        1720.6\n                    ],\n                    [\n                        1193.4,\n                        1698.4\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"Allocation of heat sources to clusters\",\n        \"type\": \"UncategorizedText\"\n    },\n    {\n        \"element_id\": \"51b39511edd19213bb45244d8e4fdeeb\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        103.8,\n                        1744.7\n                    ],\n                    [\n                        103.8,\n                        1974.1\n                    ],\n                    [\n                        808.4,\n                        1974.1\n                    ],\n                    [\n                        808.4,\n                        1744.7\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.95919,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"application/pdf\",\n            \"is_extracted\": \"true\",\n            \"languages\": [\n                \"eng\"\n            ],\n            \"last_modified\": \"2026-01-29T11:02:43\",\n            \"page_number\": 7\n        },\n        \"text\": \"The strategic placement of data centers based on these clustering methods offers significant potential for optimizing Stockholm\\u2019s district heating network. Data centers located near high-demand areas can efficiently supply heat, leveraging their excess heat for sustainable urban energy solutions. Moreover, integrating supermarkets and other existing infrastructures into the analysis further highlights opportunities for collaborative heat recovery initiatives, enhancing the overall effi- ciency and sustainability of the heat distribution network.\",\n        \"type\": \"NarrativeText\"\n    },\n    {\n        \"element_id\": \"2b5bc0855bd5cc1bc330893aca45c0c5\",\n        \"metadata\": {\n            \"coordinates\": {\n                \"layout_height\": 2205,\n                \"layout_width\": 1654,\n                \"points\": [\n                    [\n                        101.8,\n                        1977.8\n                    ],\n                    [\n                        101.8,\n                        2055.2\n                    ],\n                    [\n                        808.4,\n                        2055.2\n                    ],\n                    [\n                        808.4,\n                        1977.8\n                    ]\n                ],\n                \"system\": \"PixelSpace\"\n            },\n            \"detection_class_prob\": 0.93352,\n            \"file_directory\": \"/Users/amirshahcheraghian/AI Projects/personal-chatbot/src/business/rag/data\",\n            \"filename\": \"kthproject.pdf\",\n            \"filetype\": \"applica