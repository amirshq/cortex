# Secrets for the self-hosted Langfuse (docker-compose.yml). Copy to .env (gitignored) and fill
# every value; generate each secret with:  openssl rand -hex 32
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
NEXTAUTH_SECRET=
ENCRYPTION_KEY=          # exactly 64 hex characters: openssl rand -hex 32

# Project API keys, created on first start. The app's .env uses the same two values.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Admin login for http://localhost:3002
LANGFUSE_ADMIN_EMAIL=admin@cortex.local
LANGFUSE_ADMIN_PASSWORD=
